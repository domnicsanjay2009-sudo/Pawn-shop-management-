# Client-Side Public Environment Configuration
# Add these in your hosting environment (e.g. Firebase Hosting or Vercel) or .env.local

VITE_FIREBASE_API_KEY="AIzaSyD_YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Public Razorpay Key ID (Safe to expose on client; Key Secret must remain server-side)
VITE_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

# Optional: URL of your free standalone backend (e.g. Vercel or Render or http://localhost:5000)
# Leave empty to fall back to Firebase Cloud Functions
VITE_BACKEND_API_URL="https://your-backend.vercel.app"
