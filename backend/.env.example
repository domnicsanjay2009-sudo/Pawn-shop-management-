# Razorpay Production / Test Credentials
RAZORPAY_KEY_ID="rzp_live_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# Firebase Project Configuration
FIREBASE_PROJECT_ID="pawn-shop-management"

# Optional: Paste Firebase Service Account JSON (as a single minified string)
# Generated from Firebase Console -> Project Settings -> Service Accounts -> "Generate new private key"
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"pawn-shop-management",...}'

# Optional: Gemini API Key for AI Customer Care (Premium subscribers)
# GEMINI_API_KEY="AIzaSy..."

# Server Port (Defaults to 5000)
PORT=5000
